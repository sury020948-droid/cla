{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/root/.local/bin/graphify hook-guard search"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "/root/.local/bin/graphify hook-guard read"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session-start-skills.sh\"",
            "timeout": 15,
            "statusMessage": "Checking Claude Code skills..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ruflo-core@ruflo": true
  },
  "extraKnownMarketplaces": {
    "ruflo": {
      "source": {
        "source": "github",
        "repo": "ruvnet/ruflo",
        "sparsePaths": [
          ".claude-plugin",
          "plugins"
        ]
      }
    }
  }
}
